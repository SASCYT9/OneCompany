# Environment variables for OneCompany (do NOT commit your real secrets)
# Copy this file to .env.local and fill in values.
# .env.local is git-ignored by default.
#
# `vercel env pull <destination>` overwrites its destination. Link and verify the
# intended Vercel project/environment first, and use an ignored environment file.
# For a safe DB-less local storefront, run `npm run catalog:fallback:local` and
# set SHOP_LOCAL_CATALOG_SNAPSHOT=1 in .env.local instead.

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (PostgreSQL via Prisma)
# ─────────────────────────────────────────────────────────────────────────────
# Pooled connection URL — used at runtime by the app
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=
# Direct (non-pooled) URL — required by Prisma migrations and several scripts
# in scripts/ that bypass the pooler. If unset, prisma.config.ts falls back to DATABASE_URL.
DIRECT_URL=
# Local-only read-only catalog mode; keep disabled on Vercel.
SHOP_LOCAL_CATALOG_SNAPSHOT=0

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN PANEL & API
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=                 # One-time bootstrap/fallback credential; normal admins use DB password hashes
ADMIN_SESSION_SECRET=           # Random 32+ char string for signing admin session cookies
NEXTAUTH_SECRET=                # NextAuth signing key — REQUIRED in production

# Two distinct admin secrets — they protect DIFFERENT endpoints, do not merge:
ADMIN_API_SECRET=               # Bearer for /api/telegram/setup, /admins, /webhook-grammy?action=set
ADMIN_SECRET=                   # Bearer for media admin (mediaStore), /telegram/cron, /telegram/analytics

# Optional one-time bootstrap identity (only when no AdminUser exists and the flag is enabled)
ADMIN_EMAIL=                    # default: admin@onecompany.local
ADMIN_BOOTSTRAP_ENABLED=0       # set to 1 only for the one-time creation of an empty admin database
ADMIN_NAME=                     # default: One Company Admin

# Cron secret (used by /api/telegram/cron and Vercel-cron-triggered routes)
CRON_SECRET=

# Admin local backup retention (days). Optional; default is hardcoded.
ADMIN_LOCAL_BACKUP_RETENTION=

# Dev-only — keep 0/empty in Preview and Production
ALLOW_DEV_ADMIN_PASSWORD_FALLBACK=0
ENABLE_DEV_AUTH_BYPASS=0

# ─────────────────────────────────────────────────────────────────────────────
# TELEGRAM BOT
# ─────────────────────────────────────────────────────────────────────────────
# Create bot via @BotFather: /newbot -> obtain token
# Forward any message from your chat to @userinfobot to get chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=                              # Main chat ID for user messages forwarding (e.g., -1001234567890)
TELEGRAM_AUTO_CHAT_ID=                         # Chat ID for auto inquiries from contact form
TELEGRAM_MOTO_CHAT_ID=                         # Chat ID for moto inquiries from contact form
TELEGRAM_SHOP_ORDERS_CHAT_ID=                  # Chat ID for shop order notifications
TELEGRAM_CONTACT_TOPIC_CHAT_ID=                # Optional: forum group to mirror contact form messages
TELEGRAM_CONTACT_TOPIC_THREAD_ID=              # Optional: forum topic (message_thread_id), e.g. 3 for "Контакт"
TELEGRAM_ADMIN_IDS=                            # Comma-separated Telegram user IDs treated as superadmins
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS=            # Optional: TWA init-data freshness window (default 86400)

# Webhook protection (highly recommended): long random string, configured with secret_token
TELEGRAM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# ONE COMPANY OPERATIONS (isolated Lab bot; never reuse TELEGRAM_BOT_TOKEN)
# ─────────────────────────────────────────────────────────────────────────────
# Rollout flags fail closed in production. Enable them only after the Ops
# migrations pass in staging and BotFather has issued a fresh token.
OPS_UI_ENABLED=0
OPS_LOCAL_DEMO_MODE=0
OPS_TELEGRAM_MANAGER_ENABLED=0
OPS_TELEGRAM_NOTIFICATIONS_ENABLED=0
OPS_TELEGRAM_AUTO_CREATE_ENABLED=0
OPS_JOBS_ENABLED=0
OPS_AUTOMATIONS_ENABLED=0

OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_BOT_ID=
OPS_TELEGRAM_BOT_USERNAME=
OPS_TELEGRAM_WEBHOOK_SECRET=
OPS_TELEGRAM_CALLBACK_SECRET=
OPS_UK_WAREHOUSE_ADDRESS=
OPS_UK_WAREHOUSE_CITY=
OPS_UK_WAREHOUSE_POSTAL_CODE=
OPS_UK_WAREHOUSE_CONTACT_NAME=
OPS_UK_WAREHOUSE_PHONE=
OPS_ADMIN_BASE_URL=

# Dedicated Gemini key and dedicated private Vercel Blob store for Ops media.
OPS_GEMINI_API_KEY=
OPS_GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
OPS_GEMINI_FALLBACK_MODEL=gemini-3.5-flash
OPS_BLOB_READ_WRITE_TOKEN=
OPS_BLOB_STORE_ID=

# Local Ops Lab only — never copy these into Preview/Production
OPS_LOCAL_ADMIN_PASSWORD=                     # Minimum 14 characters
OPS_LOCAL_TELEGRAM_USER_ID=                   # Positive Telegram user ID used by local seed
OPS_LOCAL_MEDIA_DIR=                          # e.g. .ops-data/operations-media

# ─────────────────────────────────────────────────────────────────────────────
# SITE / PUBLIC URLs
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=                          # Your domain without protocol (e.g., onecompany.global)
NEXT_PUBLIC_SITE_URL=https://onecompany.global # Full site URL for sharing (used in Telegram /dashboard command)
NEXTAUTH_URL=                                  # Canonical auth URL; local example: http://localhost:3000
NEXTAUTH_URL_INTERNAL=                         # Optional server-side auth URL; derived by next.config when omitted

# ─────────────────────────────────────────────────────────────────────────────
# ANALYTICS & SEO
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=          # GSC verification code (just the value from <meta>)
NEXT_PUBLIC_GA_ID=                             # Google Analytics 4 Measurement ID
NEXT_PUBLIC_CLARITY_ID=                        # Microsoft Clarity ID
NEXT_PUBLIC_FB_PIXEL_ID=                       # Facebook Pixel ID (optional)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=                  # Optional Plausible analytics domain

# Google Analytics 4 Data API (server-side, used by /admin dashboard KPI cards)
# Steps:
#   1. In Google Cloud Console, enable "Google Analytics Data API".
#   2. Create a service account, generate a JSON key.
#   3. In GA4 → Admin → Property Access Management, grant the service-account email "Viewer".
#   4. Paste the entire JSON key (single line) into GOOGLE_APPLICATION_CREDENTIALS_JSON.
#   5. Set GA4_PROPERTY_ID to the numeric property id (Admin → Property Settings).
# Both vars are required; if either is missing, the dashboard falls back to "—".
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL (Resend)
# ─────────────────────────────────────────────────────────────────────────────
# Sign up at resend.com, verify domain, get API key
RESEND_API_KEY=
RESEND_FROM_EMAIL=                             # Optional: overrides EMAIL_FROM for shop emails
EMAIL_FROM=                                    # Sender address verified in Resend
EMAIL_AUTO=                                    # Recipient for auto inquiries
EMAIL_MOTO=                                    # Recipient for moto inquiries

# ─────────────────────────────────────────────────────────────────────────────
# SHOP — payments & orders
# ─────────────────────────────────────────────────────────────────────────────
WHITEPAY_SLUG=onecompany                       # Whitepay merchant slug
WHITEPAY_TOKEN=                                # Whitepay API token (server-side)
WHITEPAY_WEBHOOK_TOKEN=                        # Whitepay webhook signature token

# ─────────────────────────────────────────────────────────────────────────────
# SHOPIFY (mirrored storefront)
# ─────────────────────────────────────────────────────────────────────────────
SHOPIFY_ADMIN_TOKEN=                           # Custom App admin API token
SHOPIFY_ACCESS_TOKEN=                          # Legacy price-update script alias
SHOPIFY_CLIENT_ID=                             # OAuth app client id
SHOPIFY_CLIENT_SECRET=                         # OAuth app client secret
SHOPIFY_CLIENT_ID_DHS4V6=                      # Optional store-specific OAuth override used by current routes
SHOPIFY_CLIENT_SECRET_DHS4V6=                  # Matching store-specific secret
SHOPIFY_WEBHOOK_SECRET=                        # HMAC verification secret for Shopify webhooks

# ─────────────────────────────────────────────────────────────────────────────
# AIRTABLE (legacy CRM source)
# ─────────────────────────────────────────────────────────────────────────────
AIRTABLE_PAT=                                  # Personal access token
AIRTABLE_BASE_ID=                              # Confirm the intended base before any export/write script
AIRTABLE_TABLE_NAME=                           # Runtime/import/export table; do not rely on script defaults

# ─────────────────────────────────────────────────────────────────────────────
# TURN14 (parts distributor)
# ─────────────────────────────────────────────────────────────────────────────
TURN14_CLIENT_ID=                              # Used by admin/manual and scheduled supplier sync
TURN14_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# BRAND-SPECIFIC INTEGRATIONS
# ─────────────────────────────────────────────────────────────────────────────
FIEXHAUST_APP_SECRET=                          # Fi Exhaust app shared secret
FIEXHAUST_WEBHOOK_SECRET=                      # Fi Exhaust webhook signature
KWSUSPENSION_APP_SECRET=                       # KW Suspensions app shared secret
KWSUSPENSION_WEBHOOK_SECRET=                   # KW Suspensions webhook signature
BRABUS_LOCAL_ASSETS_DEPLOYED=                  # Feature flag: serve Brabus assets from /public when deployed

# External CRM sink for new orders/leads
CRM_WEBHOOK_URL=

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS (translations, descriptions)
# ─────────────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                                # Google Gemini (used by scripts/translate-gemini.mjs)
GEMINI_MODEL=                                  # Optional model override for legacy/manual Gemini scripts
SHOP_AI_API_KEY=                               # Dedicated Gemini key for One AI (server only)
SHOP_AI_EMBEDDING_API_KEY=                     # Optional dedicated paid-tier key for embedding workers
QUOTE_KNOWLEDGE_API_SECRET=                    # Read-only service token for the isolated Quote Bot
SHOP_AI_MODEL=gemini-3.5-flash-lite            # One AI schema-bound planner model
SHOP_AI_EMBEDDING_MODEL=gemini-embedding-2     # Query/chunk embedding model; prices are never embedded
SHOP_AI_OWNER_HMAC_SECRET=                     # Stable server-only 32+ byte HMAC key for conversation/rate-limit pseudonyms
SHOP_AI_ALLOWED_ORIGINS=                       # Optional comma-separated extra HTTPS origins; same-origin is always allowed
SHOP_KNOWLEDGE_EMBEDDING_PRODUCTION_ACK=0      # Set to 1 only in the controlled external production worker
SHOP_KNOWLEDGE_EMBEDDING_MAX_COST_USD=5        # Hard cost ceiling per bounded worker invocation
SHOP_KNOWLEDGE_EMBEDDING_COST_PER_1K_TOKENS_USD=0.0002 # Conservative provider-cost estimate for the ceiling
SHOP_AI_PERSIST_CONVERSATIONS=1                # Keep server-owned context in PostgreSQL
SHOP_AI_SEMANTIC_RERANK=0                      # Optional: at most one query embedding per turn
SHOP_AI_V2_ENABLED=0                           # Global One AI V2 kill switch
SHOP_AI_V2_SHADOW=0                            # Evaluate V2 without serving its results
SHOP_AI_V2_EXACT_SKU_ENABLED=0                  # Canonical exact-SKU, non-fitment baseline
SHOP_AI_V2_CATEGORIES=                         # Comma-separated category flags, e.g. exhaust,carbonAero
SHOP_AI_V2_CATEGORY_PERCENTAGES=                # Allowed rollout stages only: 0,10,50,100
SHOP_AI_EVAL_ENABLED=0                          # Preview/staging only; ignored in Vercel production
SHOP_AI_EVAL_TOKEN=                             # Server-only 32+ byte token; never use NEXT_PUBLIC_
SHOP_AI_EVAL_BASE_URL=                          # Explicit localhost/HTTPS Preview target for eval scripts
SHOP_AI_EVAL_EXPECTED_COMMIT=                   # Commit SHA expected by protected release evaluation
SHOP_AI_EVAL_REPORT_PATH=                       # Local/CI report output path
SHOP_AI_V2_RELEASE_GATE_MARKER=                 # Signed artifact for this exact production commit
SHOP_AI_V2_RELEASE_GATE_SIGNING_SECRET=          # Server/build-only 32+ byte HMAC secret
SHOP_AI_V2_CATALOG_FINGERPRINT=                  # 64-char fingerprint of the evaluated active Knowledge V2 revision
ONE_AI_QUALITY_BULK_SECRET=                     # Server-only 32+ byte HMAC secret for admin bulk previews
SHOP_AI_TRACE_SUCCESS_SAMPLE_RATE=0.1          # Errors/no-match are always traced; successes are sampled
SHOP_KNOWLEDGE_EMBEDDING_MIN_CALL_INTERVAL_MS=0 # Optional worker throttle
SHOP_KNOWLEDGE_ALLOW_NON_VERCEL_COMMIT=0        # Controlled external worker acknowledgement only
ONECOMPANY_LEGACY_KNOWLEDGE_ROOT=               # Optional local path for one-time legacy knowledge import
PERPLEXITY_API_KEY=                            # Perplexity API for research-style prompts

# Admin catalog visibility; never enable draft exposure in Production by default
SHOP_PREVIEW_DRAFTS=0

# ─────────────────────────────────────────────────────────────────────────────
# CLOUDFLARE (image / asset delivery)
# ─────────────────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME MEDIA (Vercel Blob)
# ─────────────────────────────────────────────────────────────────────────────
# Create one public store (e.g. one-company-media) and pull linked env vars
# with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
NEXT_IMAGE_REMOTE_HOSTS=                       # e.g. abc123.public.blob.vercel-storage.com

# ─────────────────────────────────────────────────────────────────────────────
# TEST / VERIFICATION TARGETS (disposable non-production environments only)
# ─────────────────────────────────────────────────────────────────────────────
SHOP_E2E_BASE_URL=http://127.0.0.1:3001        # Never point checkout E2E at Production
SHOP_SCREENSHOT_BASE_URL=http://localhost:3000 # Optional target for scripts/take_screenshots.mjs
OPS_TEST_DATABASE_URL=                         # Disposable DB for Ops persistence integration tests
OPS_DATABASE_ENV_FILE=                         # Optional ignored env file for Ops documentation sync scripts

# ─────────────────────────────────────────────────────────────────────────────
# Notes
# ─────────────────────────────────────────────────────────────────────────────
# - Never commit .env.local or any pulled environment file.
# - VERCEL*, NODE_ENV, NEXT_PHASE, GITHUB_SHA, and VERCEL_OIDC_TOKEN are platform
#   or build-provided values and are intentionally not configured here.
# - Rotate and revoke a token immediately if it is exposed, then redeploy only the
#   affected environment.
